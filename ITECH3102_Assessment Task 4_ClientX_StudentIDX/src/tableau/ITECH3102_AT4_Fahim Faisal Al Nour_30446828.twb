      <aliases enabled='yes' />
      <column caption='Resource Index' datatype='real' name='[Calculation_0108908146515972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Nbr AP classes] + [Nbr Varsity Sports] + [Nbr Clubs]) / [Enrollment] * 100' />
      </column>
      <column caption='Outcome Score' datatype='real' name='[Calculation_0108908146610181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Graduation Rate (%)] + [Perc to College] + [10th Grade MCAS English] + [10th Grade MCAS Math]) / 4' />
      </column>
      <column caption='Efficiency Ratio' datatype='real' name='[Calculation_0108908146696198]' role='measure' type='quantitative'>

      <column caption='Resource Index' datatype='real' name='[Calculation_0108908146515972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Nbr AP classes] + [Nbr Varsity Sports] + [Nbr Clubs]) / [Enrollment] * 100' />
